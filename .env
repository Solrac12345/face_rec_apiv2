# EN: Face Recognition API v2 - Environment Configuration
# FR-CA: API de reconnaissance faciale v2 - Configuration d'environnement

# Application
APP_NAME=Face Recognition API v2
DEBUG=True

# Server
HOST=0.0.0.0
PORT=8000

# Paths (absolute paths recommended for production)
KNOWN_FACES_DIR=known_faces
HAARCASCADE_PATH=data/haarcascade_frontalface_default.xml

# Face recognition tuning
FACE_DETECTION_THRESHOLD=0.35
MIN_FACE_SIZE=90
EMBEDDING_MODEL=ArcFace

# Security (generate secure values for production!)
# API_KEY=change-me-in-production
# JWT_SECRET_KEY=generate-with: openssl rand -hex 32

# Upload limits
MAX_UPLOAD_SIZE_MB=10